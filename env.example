# ============================================================
# WintermuteTuring Mission Control — Environment Variables
#
# OPSEC: This repo is public. NEVER populate this file with
# real values. It is safe to commit ONLY as a template with
# empty or placeholder values.
#
# Copy to .env.production (VPS, gitignored) for deployment.
# Copy to .env.local (gitignored) for local dev.
# ============================================================

# --- OpenClaw ---
OPENCLAW_DIR=/openclaw
OPENCLAW_GATEWAY_URL=ws://openclaw-v5t3-openclaw-1:18789
OPENCLAW_GATEWAY_TOKEN=                    # copy from VPS .env

# --- OpenRouter ---
OPENROUTER_API_KEY=                        # copy from VPS .env

# --- Google Drive (service account) ---
# Base64-encode the service account JSON:
#   base64 -w 0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_DRIVE_STG_FOLDER_ID=               # ID from Drive URL
GOOGLE_DRIVE_PERSONAL_FOLDER_ID=
GOOGLE_DRIVE_TASK_SPECS_FOLDER_ID=
GOOGLE_DRIVE_MC_BRIEFS_FOLDER_ID=

# --- Auth ---
# Generate password hash: pnpm tsx scripts/hash-password.ts yourpassword
MC_ADMIN_PASSWORD_HASH=
# Generate TOTP secret: pnpm tsx scripts/gen-totp.ts
MC_TOTP_SECRET=
# Random 64-char string for session cookie signing
AUTH_SECRET=

# --- Host Agent ---
HOST_AGENT_URL=http://host.docker.internal:3101
HOST_AGENT_TOKEN=                          # must match host agent config

# --- App ---
PORT=3100
MC_ALLOWED_HOSTS=127.0.0.1
NEXT_PUBLIC_AGENT_NAME=WintermuteTuring
NEXT_PUBLIC_TIMEZONE=America/Chicago
TELEGRAM_DELIVERY_UID=                    # Telegram UID for agent task delivery

# --- Dev only ---
# Set to 'true' to use fixture data instead of live sources
USE_FIXTURES=false
